<header class="fixed top-0 left-0 right-0 z-50 w-full border-b border-primary/10 bg-background-light/90 backdrop-blur-sm">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
    <div class="flex items-center gap-2">
      <% if logged_in? %>
        <button data-action="click->sidebar#toggle" class="p-1.5 rounded-lg hover:bg-primary/10 transition-colors" aria-label="メッセージ履歴">
          <span class="material-symbols-outlined text-primary text-2xl">menu</span>
        </button>
      <% end %>
      <%= link_to "Epistory", root_path, class: "text-xl font-display font-medium tracking-wide text-main-text" %>
    </div>
    <nav class="hidden md:flex items-center gap-3">
      <% if local_assigns[:show_anchor_nav] %>
        <a href="#how-it-works" class="text-sm font-medium text-sub-text hover:text-primary transition-colors">使い方</a>
        <a href="#why-epistory" class="text-sm font-medium text-sub-text hover:text-primary transition-colors">Epistoryとは</a>
      <% end %>
      <% if logged_in? %>
        <div class="flex items-center gap-3">
          <% if current_user.avatar_url.present? %>
            <img src="<%= current_user.avatar_url %>" alt="<%= current_user.name %>" width="32" height="32" class="h-8 w-8 rounded-full">
          <% end %>
          <span class="text-sm font-medium text-main-text"><%= current_user.name %></span>
          <%= button_to "ログアウト", logout_path, method: :delete, class: "text-sm font-medium text-sub-text hover:text-primary transition-colors" %>
        </div>
      <% else %>
        <%= link_to "ログイン", login_path, class: "text-sm font-medium text-sub-text hover:text-primary transition-colors" %>
      <% end %>
      <%= link_to "メッセージを作る", new_message_path, class: "inline-block rounded-full bg-primary px-5 py-2 text-sm font-medium text-white transition hover:bg-primary-hover hover:shadow-md" %>
    </nav>
    <div class="md:hidden flex items-center gap-3">
      <% if logged_in? %>
        <%= button_to "ログアウト", logout_path, method: :delete, class: "text-sm font-medium text-sub-text hover:text-primary transition-colors" %>
      <% else %>
        <%= link_to "ログイン", login_path, class: "text-sm font-medium text-sub-text hover:text-primary transition-colors" %>
      <% end %>
      <%= link_to "メッセージを作る", new_message_path, class: "inline-block rounded-full bg-primary px-5 py-2 text-sm font-medium text-white transition hover:bg-primary-hover hover:shadow-md" %>
    </div>
  </div>
</header>
