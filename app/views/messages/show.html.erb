<section class="py-12 px-6"
         data-controller="back-navigation"
         data-back-navigation-step6-url-value="<%= step6_message_path %>">
  <div class="mx-auto max-w-2xl" data-controller="clipboard image-export">
    <div class="relative text-center mb-8">
      <%= link_to step6_message_path,
            class: "absolute left-0 top-1/2 -translate-y-1/2 flex items-center justify-center w-9 h-9 rounded-full border-2 border-primary/20 text-sub-text hover:text-primary hover:bg-primary/5 transition-all",
            aria: { label: "選択画面に戻る" } do %>
        <span class="material-symbols-outlined" style="font-size:22px;font-variation-settings:'FILL' 0,'wght' 350,'GRAD' 0,'opsz' 24">arrow_back</span>
      <% end %>
      <h1 class="text-2xl lg:text-3xl font-bold text-main-text mb-2">メッセージが完成しました</h1>
      <p class="text-sub-text font-light">あなたの気持ちを込めたメッセージです。</p>
    </div>

    <%# 手紙風メッセージ表示 %>
    <div class="relative p-8 lg:p-10 rounded-2xl bg-white/80 border border-primary/10 shadow-sm mb-6"
         style="background-image: repeating-linear-gradient(transparent, transparent 2.2rem, rgba(192,108,94,0.08) 2.2rem, rgba(192,108,94,0.08) calc(2.2rem + 1px)); background-position: 0 1.4rem;">
      <p data-clipboard-target="source" class="text-main-text whitespace-pre-line leading-[2.2rem]"><%= @message.display_content %></p>
    </div>

    <%# アクションボタン %>
    <div class="flex gap-4 mb-4">
      <%= link_to edit_message_path(@message), class: "flex-1 h-14 bg-primary text-white rounded-xl font-bold text-lg flex items-center justify-center gap-2 hover:shadow-[0_4px_20px_rgba(192,108,94,0.3)] transition-all" do %>
        <span class="material-symbols-outlined text-xl">edit</span>
        編集する
      <% end %>
      <button type="button" data-clipboard-target="button" data-action="click->clipboard#copy"
              class="flex-1 h-14 border-2 border-primary/20 text-primary rounded-xl font-bold text-lg flex items-center justify-center gap-2 hover:bg-primary/5 transition-all">
        <span class="material-symbols-outlined text-xl">content_copy</span>
        コピーする
      </button>
    </div>

    <% if message_owner? %>
      <div class="mb-4" data-controller="ai-refine">
        <% limit_reached = logged_in? && current_user.ai_refine_limit_reached? %>
        <button type="button"
                data-action="click->ai-refine#reveal"
                class="w-full h-14 border-2 border-primary/20 text-primary rounded-xl font-bold text-lg flex items-center justify-center gap-2 hover:bg-primary/5 transition-all disabled:opacity-40 disabled:cursor-not-allowed"
                <%= "disabled" if limit_reached %>>
          <span class="material-symbols-outlined text-xl">auto_awesome</span>
          AIでブラッシュアップ
        </button>

        <%# トーン選択パネル（デフォルト非表示） %>
        <div class="hidden mt-3" data-ai-refine-target="styles">
          <p class="text-center text-sm text-sub-text mb-2">トーンを選んでください</p>
          <div class="flex flex-wrap justify-center gap-2">
            <%= button_to ai_refine_message_path(@message),
                  method: :patch,
                  class: "rounded-full px-4 py-2 text-sm border border-primary/20 text-primary hover:bg-primary/5 transition-all",
                  data: @message.edited_content.present? ? { turbo_confirm: "編集済みの内容がAIの添削結果に上書きされます。よろしいですか？" } : {},
                  form: { data: { turbo_submits_with: "ブラッシュアップ中..." } } do %>
              そのまま
            <% end %>
            <% { "casual" => "カジュアルに", "formal" => "フォーマルに", "humorous" => "ユーモラスに", "poetic" => "詩的に", "warm" => "温かく" }.each do |style, label| %>
              <%= button_to ai_refine_message_path(@message),
                    method: :patch,
                    params: { style: style },
                    class: "rounded-full px-4 py-2 text-sm border border-primary/20 text-primary hover:bg-primary/5 transition-all",
                    data: @message.edited_content.present? ? { turbo_confirm: "編集済みの内容がAIの添削結果に上書きされます。よろしいですか？" } : {},
                    form: { data: { turbo_submits_with: "#{label}..." } } do %>
                <%= label %>
              <% end %>
            <% end %>
          </div>
        </div>

        <% if logged_in? %>
          <% remaining = User::AI_REFINE_DAILY_LIMIT - current_user.ai_refine_daily_used_today %>
          <p class="text-center text-sm text-sub-text mt-2">本日の残り回数: <%= remaining %>/<%= User::AI_REFINE_DAILY_LIMIT %></p>
        <% else %>
          <p class="text-center text-sm text-sub-text mt-2">ログインするとAI添削が使えます</p>
        <% end %>
      </div>
    <% end %>

    <button type="button" data-image-export-target="button" data-action="click->image-export#save"
            class="w-full h-14 border-2 border-primary/20 text-primary rounded-xl font-bold text-lg flex items-center justify-center gap-2 hover:bg-primary/5 transition-all mb-4">
      <span class="material-symbols-outlined text-xl">image</span>
      画像で保存する
    </button>

    <%# 画像出力用（非表示） %>
    <div data-image-export-target="source" style="display:none; width:1080px; font-family:'Klee One',serif; background-color:#C5CEB5; padding:40px; position:relative;">
      <%# 白い紙面 %>
      <div style="background-color:#FAFAF5; border-radius:16px; position:relative; overflow:hidden; min-height:600px;">
        <%# 左上の葉っぱ装飾 %>
        <img src="data:image/svg+xml;base64," style="position:absolute; top:-10px; left:-10px; width:260px; height:220px; z-index:2;">
        <%# 右下の葉っぱ装飾 %>
        <img src="data:image/svg+xml;base64," style="position:absolute; bottom:-10px; right:-10px; width:220px; height:185px; z-index:2;">
        <%# 罫線付き本文エリア %>
        <div style="padding:100px 80px 60px; position:relative; z-index:1; background-image:repeating-linear-gradient(transparent, transparent calc(2.8rem - 1px), rgba(0,0,0,0.12) calc(2.8rem - 1px), rgba(0,0,0,0.12) 2.8rem); background-position:0 1.8rem;">
          <% @message.display_content.split("\n\n").each do |paragraph| %>
            <p style="font-size:28px; line-height:2.8rem; color:#3d3837; margin:0 0 2.8rem 0;"><%= sanitize(h(paragraph).gsub("\n", "<br>"), tags: %w[br]) %></p>
          <% end %>
        </div>
        <div style="padding:16px 80px 40px; text-align:right; position:relative; z-index:1;">
          <span style="font-size:18px; color:#a09590; font-style:italic;">Epistory で作成</span>
        </div>
      </div>
    </div>

    <% if message_owner? && !@message.survey_answered? %>
      <%= render "messages/survey", message: @message %>
    <% end %>

    <div class="space-y-3">
      <%= link_to "新しいメッセージを作る", new_message_path, class: "block w-full h-14 border-2 border-primary/20 text-primary rounded-xl font-bold text-lg text-center leading-[3.5rem] hover:bg-primary/5 transition-all" %>
      <%= link_to "トップに戻る", root_path, class: "block w-full h-12 text-sub-text rounded-xl font-medium text-center leading-[3rem] hover:text-primary transition-all" %>
    </div>
  </div>
</section>
